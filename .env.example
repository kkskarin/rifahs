# ── Supabase (Project Settings → API) ──
NEXT_PUBLIC_SUPABASE_URL=https://cqirofbbxoedbirijnva.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_B82mhukrFBDmZXBD34L9WA_2cnvcNjR   # publishable key — safe to share
SUPABASE_SERVICE_ROLE_KEY=          # Supabase → Project Settings → API Keys → secret key. Server only — never share

# ── Site ──
# Optional. Leave unset and the app uses whatever address it's opened on
# (rifahs.netlify.app now, ops.rifahs.com later).
NEXT_PUBLIC_SITE_URL=

# ── Shopify ──
SHOPIFY_STORE_DOMAIN=xd1uww-uu.myshopify.com
SHOPIFY_API_VERSION=2026-10
# Option A: Dev Dashboard app installed on the store (recommended).
#   Token is fetched with the client-credentials grant and refreshed automatically.
SHOPIFY_CLIENT_ID=
SHOPIFY_CLIENT_SECRET=
# Option B: a legacy custom-app Admin API token (shpat_…). If set, it is used instead.
SHOPIFY_ADMIN_TOKEN=

# Protects /api/cron/shopify-sync (the 10-minute Netlify scheduled function sends it). Any long random string.
CRON_SECRET=
BOOTSTRAP_OWNER_EMAIL=you@rifahs.com   # the first person allowed to sign in; becomes owner

# Optional: max ms one sync call may spend (Netlify stops functions after ~10s by default)
SYNC_BUDGET_MS=6000

# ── Email (no-reply@rifahs.com via Google Workspace) ──
# operations@rifahs.com mailbox + a Google app password (Google Account → Security → 2-Step Verification → App passwords).
# no-reply@rifahs.com must be an alias of operations@ and added under Gmail → Settings → Accounts → "Send mail as".
SMTP_USER=operations@rifahs.com
SMTP_PASS=
EMAIL_FROM=Kaleidoscope by Rifah <no-reply@rifahs.com>
# Optional: where replies go (no-reply@ isn't read)
EMAIL_REPLY_TO=help@rifahs.com
